{
  "name": "sein-backoffice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.mjs",
    "build": "vite build --configLoader native",
    "start": "node --env-file-if-exists=.env server/index.mjs --production",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run test && npm run build",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "decimal.js": "^10.6.0",
    "domutils": "^4.0.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "htmlparser2": "^12.0.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "pdfkit": "^0.17.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.3",
    "prettier": "^3.9.8",
    "vite": "^7.1.7"
  }
}
