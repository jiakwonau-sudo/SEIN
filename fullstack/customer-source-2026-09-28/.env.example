# Default: loopback-only local demonstration, separate persistent SQLite data.
APP_MODE=demo
PORT=4173
APP_URL=http://localhost:4173
# Production: APP_MODE=supabase, then fill these server-only values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=sein-private
MASTER_EMAIL=
# Use a long random secret to authenticate a managed scheduler.
CRON_SECRET=
RESEND_API_KEY=
MAIL_FROM=
BACKUP_DIR=

# Microsoft 365 application connection (server-only). Never expose secrets to Vite.
# Grant Mail.Send and Mail.ReadWrite only for the designated mailbox through
# Exchange application RBAC / application access policy; see MICROSOFT365_SETUP.md.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_MAIL_SENDER=
# Additional authorized shared mailboxes, comma-separated. Every mailbox must be
# included in the Exchange application RBAC scope before enabling live sending.
MS_MAIL_SENDERS=info@seinmachinery.com
# Explicit enable required; local demo never sends customer email.
MS_MAIL_ENABLED=false
MS_MAIL_INTERVAL_MS=3000
MS_MAX_MESSAGE_BYTES=20000000
